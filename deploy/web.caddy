# Контейнер unosystem-web: отдаёт файлы сайта по HTTP внутри сети Docker «unosystem».
# HTTPS и сертификаты — на входном Caddy (sites.caddy), сюда приходят запросы с исходным Host.
{
	auto_https off
}

:80 {
	encode zstd gzip

	@pulse host pulse.unosystem.ru
	handle @pulse {
		root * /srv/pulse-soon
		file_server
	}

	handle {
		root * /srv/site
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "DENY"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=604800"
		@pages path / /index.html /404.html
		header @pages Cache-Control "no-cache"
		file_server
	}

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * /srv/site
			rewrite * /404.html
			file_server
		}
	}
}
